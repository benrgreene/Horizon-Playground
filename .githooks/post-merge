#!/usr/bin/env bash
# .githooks/post-merge
# Auto-update docs via Claude Code when a merge lands on the default branch.
# Runs detached + in an isolated worktree, so your working tree is never touched.
#
# Companion to post-commit, which structurally cannot see a merge: `git merge` never invokes
# post-commit, and a fast-forward merge creates no commit object at all. The two are mutually
# exclusive in practice -- a clean merge fires only post-merge; a merge left conflicted and
# finished by hand with `git commit` fires only post-commit -- so no path is both missed and
# double-run. They also share the single-flight lock below as a backstop.
# Keep the body below in sync with post-commit.

# Re-entry guard: the doc-sync skill makes its own commits; don't recurse.
[ -n "${GITHUB_DOC_SYNC_RUNNING:-}" ] && exit 0

# post-merge's one argument is the squash flag. `git merge --squash` only stages the changes;
# nothing has landed on the branch yet, so let the follow-up `git commit` (and post-commit) sync.
[ "${1:-0}" = "1" ] && exit 0

# Unlike post-commit -- which runs on whatever branch you happened to commit to -- post-merge
# runs after HEAD has been updated, so this reads the branch the merge landed *on*, not the one
# merged in. It also means `git pull` on the default branch syncs docs, which is what we want.
default_branch="main"
current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
[ "$current_branch" = "$default_branch" ] || exit 0

# Need the Claude CLI; skip quietly (never block the merge) if missing.
command -v claude >/dev/null 2>&1 || {
  echo "github-doc-sync: 'claude' CLI not found on PATH; skipping doc sync." >&2
  exit 0
}

repo_root="$(git rev-parse --show-toplevel)"
# Distinct prefix from post-commit's so you can tell which hook fired from the log name alone.
# (On BSD/macOS mktemp the X's stay literal -- it appends its own suffix -- which is harmless.)
log="$(mktemp -t doc-sync-merge-XXXXXX)"
echo "github-doc-sync: post-merge starting documentation sync in the background -> $log"

# Detached background subshell with its own isolated worktree at the default branch.
# shopify-documentation-sync creates its own docs/*-sync-* branch there and opens a PR.
(
  set -uo pipefail
  export GITHUB_DOC_SYNC_RUNNING=1

  # Git exports GIT_DIR/GIT_INDEX_FILE/GIT_WORK_TREE/etc. into hook processes; nested git commands
  # inherit them, so `git worktree add` below tries to write the new worktree's index.lock at the
  # wrong path ("Unable to create '.../.git/index.lock': No such file or directory"). Clear them so
  # nested git (and the git claude runs inside the worktree) rediscovers context from -C / cwd.
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_NAMESPACE GIT_QUARANTINE_PATH

  # Single-flight: an atomic mkdir lock so concurrent commits to the default
  # branch don't spawn duplicate syncs (and duplicate PRs). Lives in .git (untracked).
  lock="$repo_root/.git/doc-sync.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    echo "github-doc-sync: a sync is already running; skipping." >&2
    exit 0
  fi
  worktree=""
  cleanup() {
    [ -n "$worktree" ] && git -C "$repo_root" worktree remove --force "$worktree" >/dev/null 2>&1
    git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
    rmdir "$lock" 2>/dev/null || true
  }
  trap cleanup EXIT

  worktree="$(mktemp -d -t doc-sync-wt-XXXXXX)"
  # --detach is required: the default branch is already checked out in the main worktree.
  if ! git -C "$repo_root" worktree add --quiet --detach "$worktree" "$default_branch"; then
    echo "github-doc-sync: could not create worktree; aborting." >&2
    exit 0
  fi
  cd "$worktree"
  claude -p "Use the shopify-documentation-sync skill to update this repository's documentation. The docs live in the 'documentation/' directory at the repo root — write pages there, creating the directory if it is absent. Then commit on a new branch and open a pull request." \
    --permission-mode acceptEdits \
    --allowedTools "Skill,Read,Write,Edit,Glob,Grep,Agent,Bash"
) >>"$log" 2>&1 &

disown 2>/dev/null || true
exit 0
